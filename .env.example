# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# --- Demo / mock mode ---
# Set to 1 to run the whole app with simulated platforms: no developer apps,
# no real posting. Connect, compose, schedule and cron all work end to end.
# Refuses to start in production unless ALLOW_MOCK_IN_PRODUCTION=1 too.
NEXT_PUBLIC_PLATFORM_MOCK=

# --- Implemented platforms (Phase 1) ---
# X: developer.x.com — OAuth 2.0 Confidential Client, PKCE required.
# Scopes: tweet.read tweet.write users.read media.write offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn: linkedin.com/developers — needs the "Share on LinkedIn" and
# "Sign In with LinkedIn using OpenID Connect" products enabled.
# Scopes: openid profile email w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn versions its REST API by month; bump as you adopt newer ones.
LINKEDIN_API_VERSION=202506

# --- Not implemented yet (Phase 2) ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Signs the OAuth state cookie. Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Guards /api/publish, which runs with service-role credentials and must never
# be reachable from outside. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Cron security (used to authenticate the scheduler endpoint)
CRON_SECRET=
